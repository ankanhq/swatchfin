# Copy this file to .env and fill in your own keys.
# .env is git-ignored. Never commit real keys.

# TinyFish API key (Search, Fetch, Browser): https://agent.tinyfish.ai → API Keys
TINYFISH_API_KEY=

# Anthropic API key (tone-of-voice analysis): https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional. Every setting below has a sensible default (backend/app/config.py);
# remove the # and change the value only if you need to.
# ANTHROPIC_MODEL=claude-sonnet-5-5   # the Claude model for tone of voice (e.g. claude-opus-5-5)
# LOG_LEVEL=INFO
# MAX_RUNNING_JOBS=2            # guides made at the same time
# MAX_WAITING_JOBS=20           # guides that may wait for a free slot
# JOB_TIMEOUT_SECONDS=150       # stop a guide that takes longer (keep under 180)
# GUIDE_RETENTION_DAYS=30       # delete saved guides older than this
# USE_BROWSER=true              # false: skip TinyFish Browser (colours, fonts) to save wallet credit
# NEW_GUIDES_PER_HOUR=20        # per visitor (IP address)
# API_REQUESTS_PER_MINUTE=300   # per visitor (IP address)
