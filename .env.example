# Copy this file to .env and fill in your own keys.
# .env is git-ignored. Never commit real keys.
# Spaces, line breaks and quotes around a key are taken out when it is read.

# TinyFish API key (Search, Fetch, Browser): https://agent.tinyfish.ai → API Keys
TINYFISH_API_KEY=

# Language models for the tone of voice and key messaging. Swatchfin asks them in this order and
# moves on to the next when one gives no usable answer (an error, too slow, a rate limit, no credit).
# Set at least one; a model without a key is left out.
# Anthropic (Claude): https://console.anthropic.com
ANTHROPIC_API_KEY=
# Google Gemini (free tier available): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq (free tier available): https://console.groq.com/keys
GROQ_API_KEY=

# Optional. Every setting below has a sensible default (backend/app/config.py);
# remove the # and change the value only if you need to.
# ANTHROPIC_MODEL=claude-sonnet-5-5   # the Claude model for tone of voice (e.g. claude-opus-5-5)
# GEMINI_MODEL=gemini-3.8-flash       # the Gemini model (e.g. gemini-3.6-flash)
# GROQ_MODEL=openai/gpt-oss-120b      # a Groq model with strict structured outputs (e.g. openai/gpt-oss-20b)
# LLM_ORDER=anthropic,gemini,groq     # the order they are asked in; leave one out to never use it
# LOG_LEVEL=INFO
# MAX_RUNNING_JOBS=2            # guides made at the same time
# MAX_WAITING_JOBS=20           # guides that may wait for a free slot
# JOB_TIMEOUT_SECONDS=150       # stop a guide that takes longer (keep under 180)
# GUIDE_RETENTION_DAYS=30       # delete saved guides older than this
# USE_BROWSER=true              # false: skip TinyFish Browser (colours, fonts) to save wallet credit
# SAMPLE_GUIDES=false           # true: serve the MOCK sample guides (?id=mock) while building the guide page
# DAILY_GUIDE_LIMIT=50          # new guides a day for everyone together (UTC days), counted at TinyFish on startup
# NEW_GUIDES_PER_VISITOR_PER_DAY=5   # per visitor (IP address)
# API_REQUESTS_PER_MINUTE=300   # per visitor (IP address)
# REUSE_HOURS=24                # reuse a complete guide for the same site made within this many hours (0: off)
# PROXY_HOPS=0                  # proxies in front of the app that add to X-Forwarded-For (see docs/deploy-render.md)
